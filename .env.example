# Production: use APP_ENV=production, APP_DEBUG=false and the real https APP_URL.
APP_NAME=SQUAD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Riyadh

# Comma-separated proxy IPs or "*" when TLS terminates at a trusted reverse proxy.
# Leave blank when the application is exposed directly.
TRUSTED_PROXIES=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true in production when the site is served over HTTPS.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@squad.example"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Media disk: "public" for local storage or "s3" for S3-compatible storage.
# When using S3, configure bucket CORS for 3D model loading (see docs/deployment.md).
MEDIA_DISK=public

# WhatsApp number in international format (e.g. 9665XXXXXXXX). Can also be set
# from the admin settings screen. Leave blank until a real number is available.
STORE_WHATSAPP_NUMBER=

# Optional: create the first super admin during `php artisan db:seed`.
# Leave blank in production unless you intend to create one now, and never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
